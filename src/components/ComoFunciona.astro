---
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import FioMarker from "./FioMarker.astro";
import { howItWorks } from "../content/site";

const icons = ["sprout", "compass", "clock", "shield"] as const;
---

<section id="como-funciona" class="relative section-padding" aria-labelledby="como-funciona-heading">
  <FioMarker icon="dove" />
  <Container>
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">{howItWorks.eyebrow}</p>
      <h2 id="como-funciona-heading" class="mt-4">{howItWorks.heading}</h2>
    </div>

    <div class="mt-14 grid gap-10 sm:grid-cols-2">
      {
        howItWorks.items.map((item, i) => (
          <div
            class="border-t-2 border-gold/40 pt-6"
            data-reveal
            style={`transition-delay:${Math.min(i, 3) * 80}ms`}
          >
            <Icon name={icons[i]} class="h-6 w-6" />
            <h3 class="mt-4">{item.title}</h3>
            <p class="measure mt-2 text-graphite">{item.text}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>

---
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import { googleProfile } from "../content/site";
---

<section class="relative pb-[clamp(3rem,6vw,5rem)]" aria-labelledby="perfil-google-heading">
  <Container>
    <div
      class="radius-organic-flip mx-auto flex max-w-3xl flex-col items-center gap-6 bg-sand/70 px-[clamp(1.5rem,5vw,3.5rem)] py-[clamp(2rem,5vw,3rem)] text-center md:flex-row md:justify-between md:gap-10 md:text-left"
      data-reveal
    >
      <div class="max-w-md">
        <p class="eyebrow">{googleProfile.eyebrow}</p>
        <h2 id="perfil-google-heading" class="mt-3 !text-[clamp(1.5rem,3vw,1.875rem)]">
          {googleProfile.heading}
        </h2>
        <p class="mt-3 text-graphite">{googleProfile.text}</p>
      </div>

      <a
        href={googleProfile.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={googleProfile.ctaAriaLabel}
        class="btn btn-secondary shrink-0"
      >
        {googleProfile.ctaLabel}
        <Icon name="arrow-right" class="h-5 w-5" />
      </a>
    </div>
  </Container>
</section>

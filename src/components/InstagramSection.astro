---
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import ContentCarousel from "./ContentCarousel.astro";
import { instagramSection, contact } from "../content/site";
---

<section id="instagram" class="relative section-padding" aria-labelledby="instagram-heading">
  <Container>
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">{instagramSection.eyebrow}</p>
      <h2 id="instagram-heading" class="mt-4">{instagramSection.heading}</h2>
      <p class="measure mx-auto mt-4 text-graphite">{instagramSection.text}</p>
    </div>

    <div class="mt-14" data-reveal style="transition-delay:60ms">
      <ContentCarousel />
    </div>

    <div class="mt-10 flex justify-center" data-reveal style="transition-delay:120ms">
      <a
        href={contact.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary"
      >
        <Icon name="instagram" class="h-5 w-5" />
        {instagramSection.ctaLabel}
      </a>
    </div>
  </Container>
</section>

---
// Carrossel de fotos da seção "Conteúdo" — trilha horizontal contínua.
// Substituiu a pilha de fotos (2026-09) a pedido da cliente, depois de
// comparar 3 modelos: a trilha venceu por ser a mais leve (scroll nativo
// com scroll-snap, sem JS de posicionamento) e a mais natural no celular.
//
// As fotos são prints reais de posts do Instagram, quadrados (~1:1). Por
// isso a moldura usa aspect-ratio 1/1 — não 4/5 como no modelo antigo —
// já que esses posts têm texto quase até a borda; um recorte mais alto que
// largo cortaria títulos e frases. Em 1:1 o corte fica mínimo (só o post 1,
// levemente retangular, perde ~3% no topo/base, bem dentro da margem em
// branco do design).
//
// Resiliência: scroll-snap é comportamento nativo do navegador, então a
// trilha funciona (arrastar, deslizar no touch) mesmo sem JavaScript. O
// JS só acrescenta as setas de navegação, o contador "01 — 05" e o arraste
// com mouse (pointer events) para desktop.
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import post1 from "../assets/images/posts/post-1.png";
import post2 from "../assets/images/posts/post-2.png";
import post3 from "../assets/images/posts/post-3.png";
import post4 from "../assets/images/posts/post-4.png";
import post5 from "../assets/images/posts/post-5.png";

const slides = [
  {
    src: post1,
    alt: "Post do Instagram: Terapia é um espaço seguro para ser você — sem julgamento, com empatia, com respeito, com você.",
  },
  {
    src: post2,
    alt: "Post do Instagram, reflexão: você não pode controlar tudo o que acontece lá fora, mas pode cuidar do que acontece dentro de você.",
  },
  {
    src: post3,
    alt: "Post do Instagram: pequenas escolhas diárias mudam tudo — comece por você.",
  },
  {
    src: post4,
    alt: "Post do Instagram, autoconhecimento: entender suas emoções é o primeiro passo para transformá-las.",
  },
  {
    src: post5,
    alt: "Post do Instagram: você não precisa dar conta de tudo sozinha. Buscar ajuda é um ato de coragem e autocuidado — estou aqui para te ouvir.",
  },
] as const;

const total = String(slides.length).padStart(2, "0");
---

<div class="trilha" data-carousel>
  <div
    class="trilha-track no-scrollbar -mx-2 flex gap-4 overflow-x-auto px-2 pb-2"
    data-track
    tabindex="0"
    role="group"
    aria-label="Publicações do Instagram, arraste para navegar"
  >
    {
      slides.map((slide, i) => (
        <div
          class:list={[
            "trilha-card",
            i % 2 === 0 ? "radius-organic" : "radius-organic-flip",
          ]}
          data-card
        >
          <Picture
            src={slide.src}
            alt={slide.alt}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[240, 340, 480]}
            sizes="(min-width: 768px) 300px, 62vw"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      ))
    }
  </div>

  <div class="trilha-thread" aria-hidden="true"></div>

  <div class="mt-6 flex items-center justify-center gap-3">
    <button type="button" class="trilha-btn tap-target" data-prev aria-label="Foto anterior">
      <Icon name="chevron-right" class="h-4 w-4 rotate-180" />
    </button>
    <p class="caption min-w-[4.5rem] text-center text-graphite" data-counter>01 — {total}</p>
    <button type="button" class="trilha-btn tap-target" data-next aria-label="Próxima foto">
      <Icon name="chevron-right" class="h-4 w-4" />
    </button>
  </div>
</div>

<style>
  .no-scrollbar {
    scrollbar-width: none;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .trilha-track {
    scroll-snap-type: x mandatory;
    cursor: grab;
    scroll-behavior: smooth;
  }

  .trilha-track.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  .trilha-card {
    flex: 0 0 auto;
    width: clamp(220px, 62vw, 300px);
    aspect-ratio: 1 / 1;
    overflow: hidden;
    scroll-snap-align: center;
  }

  .trilha-thread {
    height: 1.5px;
    margin-top: 0.5rem;
    background: var(--color-gold);
    opacity: 0.4;
  }

  .trilha-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1.5px solid var(--color-warmgray);
    background: var(--color-canvas);
    color: var(--color-coffee);
    transition:
      border-color 0.3s var(--ease-calm),
      background-color 0.3s var(--ease-calm);
  }

  .trilha-btn:hover {
    border-color: var(--color-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .trilha-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-carousel]");
  const track = root?.querySelector<HTMLElement>("[data-track]");
  const cards = track ? Array.from(track.querySelectorAll<HTMLElement>("[data-card]")) : [];
  const prevBtn = root?.querySelector<HTMLButtonElement>("[data-prev]");
  const nextBtn = root?.querySelector<HTMLButtonElement>("[data-next]");
  const counter = root?.querySelector<HTMLElement>("[data-counter]");

  if (root && track && prevBtn && nextBtn && counter && cards.length) {
    const total = cards.length;

    const nearestIndex = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      cards.forEach((card, i) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const dist = Math.abs(cardCenter - center);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      return best;
    };

    const updateCounter = () => {
      const i = nearestIndex();
      counter.textContent = `${String(i + 1).padStart(2, "0")} — ${String(total).padStart(2, "0")}`;
    };

    const goTo = (index: number) => {
      const clamped = Math.max(0, Math.min(total - 1, index));
      cards[clamped]?.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
    };

    let scrollTimer = 0;
    track.addEventListener("scroll", () => {
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(updateCounter, 80);
    });

    prevBtn.addEventListener("click", () => goTo(nearestIndex() - 1));
    nextBtn.addEventListener("click", () => goTo(nearestIndex() + 1));

    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        goTo(nearestIndex() + 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        goTo(nearestIndex() - 1);
      }
    });

    // Arraste com mouse — o touch e o trackpad já rolam nativamente.
    let isDown = false;
    let startX = 0;
    let startScroll = 0;

    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "touch") return;
      isDown = true;
      track.classList.add("dragging");
      startX = e.clientX;
      startScroll = track.scrollLeft;
      track.setPointerCapture(e.pointerId);
    });

    track.addEventListener("pointermove", (e) => {
      if (!isDown) return;
      track.scrollLeft = startScroll - (e.clientX - startX);
    });

    const stopDrag = () => {
      if (!isDown) return;
      isDown = false;
      track.classList.remove("dragging");
      goTo(nearestIndex());
    };

    track.addEventListener("pointerup", stopDrag);
    track.addEventListener("pointercancel", stopDrag);
    track.addEventListener("pointerleave", stopDrag);

    updateCounter();
  }
</script>

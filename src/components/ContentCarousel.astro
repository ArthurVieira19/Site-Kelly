---
// Carrossel de fotos da seção "Conteúdo" — pilha de retratos levemente
// espalhados (como fotografias reais deixadas sobre uma mesa), não um
// carrossel giratório em 3D. Cada avanço desliza a foto da frente para
// trás da pilha com uma transição suave em 2D (translate/rotate/scale via
// CSS puro), sem perspectiva nem matriz 3D.
//
// Sem imagens finais do Instagram ainda (pendência da seção 10 do
// CLAUDE.md) — usa 5 posições reaproveitando as 4 fotos já aprovadas no
// site (uma delas repetida) só como placeholder visual.
//
// Resiliência: a posição de cada foto na pilha (--stack-offset) já nasce
// definida no HTML, então mesmo sem JavaScript a pilha aparece com a
// primeira foto na frente e as demais espiando atrás, paradas — nunca
// quebrada. O JavaScript só acrescenta a troca de foto (clique, setas) e
// o avanço automático lento, pausável e desligado por padrão quando
// prefers-reduced-motion está ativo.
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import retratoPhoto from "../assets/images/retrato-perfil.jpg";
import consultorioPhoto from "../assets/images/consultorio.jpg";
import salaPhoto from "../assets/images/retrato-sala.png";
import onlinePhoto from "../assets/images/trabalho-online.jpg";
import { about, modalities, hero } from "../content/site";

const slides = [
  { src: retratoPhoto, alt: about.imageAlt, rotate: -2 },
  { src: consultorioPhoto, alt: modalities.presencial.imageAlt, rotate: 1.5 },
  { src: salaPhoto, alt: hero.imageAlt, rotate: -2.5 },
  { src: onlinePhoto, alt: modalities.online.imageAlt, rotate: 2 },
  { src: consultorioPhoto, alt: modalities.presencial.imageAlt, rotate: -1 },
] as const;

const total = String(slides.length).padStart(2, "0");
---

<div class="photo-stack mx-auto max-w-xs" data-carousel>
  <div class="stack-frame">
    <div
      class="pointer-events-none absolute inset-0 -z-10 scale-125 rounded-full bg-sage/25 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="stack" data-stack aria-hidden="true">
      {
        slides.map((slide, i) => (
          <div
            class:list={["stack-card", i % 2 === 0 ? "radius-organic" : "radius-organic-flip"]}
            data-card
            style={`--stack-offset:${i};--base-rotate:${slide.rotate}deg`}
          >
            <Picture
              src={slide.src}
              alt={slide.alt}
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              widths={[280, 400, 560]}
              sizes="(min-width: 640px) 18rem, 70vw"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-7 flex items-center justify-center gap-3">
    <button type="button" class="stack-btn" data-prev aria-label="Foto anterior">
      <Icon name="chevron-right" class="h-4 w-4 rotate-180" />
    </button>
    <p class="caption min-w-[4.5rem] text-center text-graphite" data-counter>01 — {total}</p>
    <button type="button" class="stack-btn" data-next aria-label="Próxima foto">
      <Icon name="chevron-right" class="h-4 w-4" />
    </button>
    <span class="mx-1 h-px w-5 bg-warmgray" aria-hidden="true"></span>
    <button
      type="button"
      class="stack-btn"
      data-toggle
      aria-pressed="false"
      aria-label="Retomar a troca automática de fotos"
    >
      <span data-icon="pause" class="hidden"><Icon name="pause" class="h-4 w-4" /></span>
      <span data-icon="play"><Icon name="play" class="h-4 w-4" /></span>
    </button>
  </div>
</div>

<style>
  .stack-frame {
    position: relative;
    isolation: isolate;
    aspect-ratio: 4 / 5;
    width: 100%;
  }

  .stack {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .stack-card {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: pointer;
    transform-origin: 50% 88%;
    /* Da 3ª foto pra trás a posição some (fica coberta), então ela é
       congelada na posição da 2ª — assim a pilha nunca continua se
       espalhando pra fora da moldura em telas estreitas; só a opacidade
       (com --stack-offset "cru") segue caindo até sumir de vez. */
    --stack-pos: min(var(--stack-offset), 2);
    translate: calc(var(--stack-pos) * 0.65rem) calc(var(--stack-pos) * 0.5rem);
    rotate: calc(var(--base-rotate) + var(--stack-pos) * 1.8deg);
    scale: calc(1 - var(--stack-pos) * 0.05);
    opacity: calc(1 - var(--stack-offset) * 0.32);
    z-index: calc(20 - var(--stack-offset));
    transition:
      translate 0.7s var(--ease-calm),
      rotate 0.7s var(--ease-calm),
      scale 0.7s var(--ease-calm),
      opacity 0.5s var(--ease-calm);
  }

  .caption {
    font-variant-numeric: tabular-nums;
  }

  .stack-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1.5px solid var(--color-warmgray);
    background: var(--color-canvas);
    color: var(--color-coffee);
    transition:
      border-color 0.3s var(--ease-calm),
      background-color 0.3s var(--ease-calm);
  }

  .stack-btn:hover {
    border-color: var(--color-gold);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-carousel]");
  const stack = root?.querySelector<HTMLElement>("[data-stack]");
  const cards = stack ? Array.from(stack.querySelectorAll<HTMLElement>("[data-card]")) : [];
  const prevBtn = root?.querySelector<HTMLButtonElement>("[data-prev]");
  const nextBtn = root?.querySelector<HTMLButtonElement>("[data-next]");
  const toggle = root?.querySelector<HTMLButtonElement>("[data-toggle]");
  const counter = root?.querySelector<HTMLElement>("[data-counter]");
  const iconPause = toggle?.querySelector<HTMLElement>('[data-icon="pause"]');
  const iconPlay = toggle?.querySelector<HTMLElement>('[data-icon="play"]');

  if (root && stack && prevBtn && nextBtn && toggle && counter && iconPause && iconPlay && cards.length) {
    const COUNT = cards.length;
    const AUTOPLAY_MS = 5200;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let current = 0;
    let userPaused = reduceMotion;
    let inView = false;
    let timer = 0;

    const layout = () => {
      cards.forEach((card, i) => {
        const offset = (i - current + COUNT) % COUNT;
        card.style.setProperty("--stack-offset", String(offset));
        card.style.pointerEvents = offset <= 2 ? "auto" : "none";
      });
      counter.textContent = `${String(current + 1).padStart(2, "0")} — ${String(COUNT).padStart(2, "0")}`;
    };

    const setToggleUI = () => {
      toggle.setAttribute("aria-pressed", String(!userPaused));
      toggle.setAttribute(
        "aria-label",
        userPaused ? "Retomar a troca automática de fotos" : "Pausar a troca automática de fotos",
      );
      iconPause.classList.toggle("hidden", userPaused);
      iconPlay.classList.toggle("hidden", !userPaused);
    };

    // Reagenda a si mesma a cada troca — evita o desvio de um setInterval
    // fixo e para de vez enquanto pausada ou fora da tela.
    const scheduleNext = () => {
      window.clearTimeout(timer);
      if (userPaused || !inView) return;
      timer = window.setTimeout(() => {
        goTo(current + 1);
        scheduleNext();
      }, AUTOPLAY_MS);
    };

    function goTo(index: number) {
      current = ((index % COUNT) + COUNT) % COUNT;
      layout();
    }

    new IntersectionObserver(
      (entries) => {
        inView = entries[0]?.isIntersecting ?? false;
        if (inView) scheduleNext();
        else window.clearTimeout(timer);
      },
      { threshold: 0.2 },
    ).observe(stack);

    prevBtn.addEventListener("click", () => {
      goTo(current - 1);
      scheduleNext();
    });

    nextBtn.addEventListener("click", () => {
      goTo(current + 1);
      scheduleNext();
    });

    cards.forEach((card, i) => {
      card.addEventListener("click", () => {
        goTo(i === current ? current + 1 : i);
        scheduleNext();
      });
    });

    toggle.addEventListener("click", () => {
      userPaused = !userPaused;
      setToggleUI();
      scheduleNext();
    });

    setToggleUI();
    layout();
  }
</script>

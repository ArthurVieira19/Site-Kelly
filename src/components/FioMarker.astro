---
import Icon from "./Icon.astro";

interface Props {
  icon: "leaf" | "dove";
}

const { icon } = Astro.props;
---

<div class="fio-marker" data-reveal aria-hidden="true">
  <Icon name={icon} class="h-4 w-4" />
</div>

<style>
  .fio-marker {
    position: absolute;
    left: var(--fio-left);
    top: 0;
    transform: translate(-50%, -50%);
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-canvas);
    border: 1.5px solid var(--color-gold);
    border-radius: 999px;
    z-index: 2;
  }

  .fio-marker.js-reveal {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5);
    transition:
      opacity 0.5s var(--ease-calm),
      transform 0.5s var(--ease-calm);
  }

  .fio-marker.js-reveal.is-visible {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
</style>

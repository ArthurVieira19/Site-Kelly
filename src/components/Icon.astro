---
// Ícones de linha únicos, traço 1,5px, sem preenchimento — nunca coloridos.
// Conjunto mínimo desenhado à mão para o site (sem dependência externa de ícones).
interface Props {
  name:
    | "leaf"
    | "dove"
    | "hand"
    | "heart"
    | "arrow-right"
    | "chevron-down"
    | "whatsapp"
    | "instagram"
    | "phone"
    | "mail"
    | "map-pin"
    | "compass"
    | "shield"
    | "clock"
    | "sprout"
    | "pause"
    | "play";
  class?: string;
  strokeClass?: "icon-line" | "icon-line-coffee";
}

const { name, class: className = "", strokeClass = "icon-line" } = Astro.props;
---

{
  name === "leaf" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M5 19c8 0 14-6 14-14-8 0-14 6-14 14Z" />
      <path d="M5 19c0-6 3-10 8-12" />
    </svg>
  )
}
{
  name === "dove" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M3 14c2.5 1.5 5 1 6.5-1C11 10.8 12.5 9 15 8c2-.8 4-.5 5.5.5-1 2-3 3-5 3.2" />
      <path d="M9.5 13c-1.5 3-1 6 1 8.5" />
      <circle cx="16.3" cy="7.2" r=".6" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === "hand" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M7 12.5V6a1.5 1.5 0 0 1 3 0v5" />
      <path d="M10 11V4.5a1.5 1.5 0 0 1 3 0V11" />
      <path d="M13 11.2V5.5a1.5 1.5 0 0 1 3 0V12" />
      <path d="M16 12v-3a1.5 1.5 0 0 1 3 0v6c0 3.9-2.7 7-7 7-2.6 0-4-1-5.5-2.8L3.6 15c-.6-.8-.4-1.8.4-2.3.7-.4 1.5-.3 2 .3L7 14.5" />
    </svg>
  )
}
{
  name === "heart" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M12 20.2s-7.6-4.6-10-9.4C.5 7.4 2.3 4 5.8 4c2 0 3.5 1.1 4.2 2.6C10.7 5.1 12.2 4 14.2 4c3.5 0 5.3 3.4 3.8 6.8-2.4 4.8-10 9.4-10 9.4Z" />
    </svg>
  )
}
{
  name === "arrow-right" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M4 12h16" />
      <path d="M14 6l6 6-6 6" />
    </svg>
  )
}
{
  name === "chevron-down" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M6 9l6 6 6-6" />
    </svg>
  )
}
{
  name === "whatsapp" && (
    <svg viewBox="0 0 24 24" class={className} aria-hidden="true" fill="currentColor" stroke="none">
      <path d="M17.5 14.4c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.1.2-.3.3-.4.1-.2 0-.4 0-.5C10 9 9.5 7.8 9.3 7.3c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.4Z" />
      <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm0 18.2c-1.6 0-3.2-.4-4.5-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Z" />
    </svg>
  )
}
{
  name === "instagram" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.2" cy="6.8" r=".6" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === "phone" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M6.5 3.5h2l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5l1.5-2 4 1.5v2c0 1.1-.9 2-2 2-7.5 0-13.5-6-13.5-13.5 0-1.1.9-2 2-2Z" />
    </svg>
  )
}
{
  name === "mail" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <rect x="3" y="5.5" width="18" height="13" rx="2.5" />
      <path d="M4 7l8 6 8-6" />
    </svg>
  )
}
{
  name === "map-pin" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M12 21.5s7-6.3 7-12A7 7 0 0 0 5 9.5c0 5.7 7 12 7 12Z" />
      <circle cx="12" cy="9.5" r="2.3" />
    </svg>
  )
}
{
  name === "compass" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <circle cx="12" cy="12" r="8.5" />
      <path d="M14.8 9.2 13 13l-3.8 1.8L11 11l3.8-1.8Z" />
    </svg>
  )
}
{
  name === "shield" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M12 3.5 19 6v6c0 5-3 7.9-7 9-4-1.1-7-4-7-9V6l7-2.5Z" />
      <path d="M9.2 12.2l1.8 1.8 3.4-3.6" />
    </svg>
  )
}
{
  name === "clock" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </svg>
  )
}
{
  name === "sprout" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M12 21v-9" />
      <path d="M12 12C12 7 8 5.5 4.5 6 4.5 10 7 12.5 12 12Z" />
      <path d="M12 9c0-3.5 2.7-5 6-5 0 3.7-2.2 6-6 5Z" />
    </svg>
  )
}
{
  name === "pause" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M8 5.5v13" />
      <path d="M16 5.5v13" />
    </svg>
  )
}
{
  name === "play" && (
    <svg viewBox="0 0 24 24" class={className} class:list={[strokeClass]} aria-hidden="true">
      <path d="M8 5.5v13l11-6.5-11-6.5Z" />
    </svg>
  )
}

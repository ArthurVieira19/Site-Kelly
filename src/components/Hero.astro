---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import heroPhoto from "../assets/images/retrato-sala.png";
import { hero, professional, whatsappUrl } from "../content/site";
---

<section id="hero" class="relative overflow-hidden">
  <div
    class="hero-grid mx-auto max-w-[84rem] gap-10 px-[clamp(2.75rem,9vw,5rem)] pb-20 pt-28 sm:pt-32 md:gap-14 md:pb-24 lg:mx-0 lg:max-w-none lg:gap-0 lg:px-0 lg:pb-0 lg:pt-0"
  >
    <div class="hero-eyebrow mx-auto max-w-md text-center lg:mx-0 lg:max-w-none lg:pl-[var(--content-inset)] lg:pr-8 lg:text-left">
      <p class="eyebrow-script">{hero.eyebrow}</p>
      <h1 class="mt-5 lg:text-[2.75rem] lg:leading-[1.15]">{hero.headline}</h1>
    </div>

    <div class="hero-photo">
      <div class="relative mx-auto w-full max-w-md lg:mx-0 lg:flex lg:h-full lg:max-w-none lg:flex-col">
        <div
          class="pointer-events-none absolute inset-0 -z-10 scale-110 rounded-full bg-sage/20 blur-3xl lg:hidden"
          aria-hidden="true"
        >
        </div>
        <div class="radius-organic-lg relative aspect-[4/3] w-full overflow-hidden lg:aspect-auto lg:flex-1 lg:rounded-none">
          <Picture
            src={heroPhoto}
            alt={hero.imageAlt}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[500, 800, 1024]}
            sizes="(min-width: 1024px) 62vw, min(28rem, 100vw)"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover object-center lg:object-[center_22%]"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-canvas)_0%,rgba(247,245,242,0)_20%,rgba(247,245,242,0)_80%,var(--color-canvas)_100%)] lg:bg-[linear-gradient(to_right,var(--color-canvas)_0%,rgba(247,245,242,0)_24%)]"
            aria-hidden="true"
          >
          </div>
        </div>

        <div
          class="hidden items-center gap-3 border-t border-warmgray/60 px-[clamp(2rem,4vw,3rem)] py-4 lg:flex"
        >
          <span class="h-px w-8 shrink-0 bg-gold" aria-hidden="true"></span>
          <p class="caption text-graphite">
            {professional.fullName} · {professional.role} · {professional.crpLabel}
          </p>
        </div>
      </div>
    </div>

    <div class="hero-body mx-auto max-w-md text-center lg:mx-0 lg:max-w-none lg:pl-[var(--content-inset)] lg:pr-8 lg:text-left">
      <p class="measure mx-auto text-lg text-graphite lg:mx-0">{hero.sub}</p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-4 lg:flex-col lg:items-start lg:gap-3">
        <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <Icon name="whatsapp" class="h-5 w-5" />
          {hero.ctaPrimary}
        </a>
        <a href="#como-funciona" class="btn btn-secondary">
          {hero.ctaSecondary}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="mt-10 flex flex-col items-center gap-4 lg:hidden">
        <span class="h-px w-10 bg-gold" aria-hidden="true"></span>
        <p class="caption text-balance text-graphite">
          {professional.fullName} · {professional.role} · {professional.crpLabel}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-areas: "eyebrow" "photo" "body";
  }

  .hero-eyebrow {
    grid-area: eyebrow;
  }

  .hero-photo {
    grid-area: photo;
  }

  .hero-body {
    grid-area: body;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: calc(var(--content-inset) + 26rem) 1fr;
      grid-template-rows: minmax(6rem, 1fr) auto auto minmax(2rem, 1fr);
      grid-template-areas:
        ".       photo"
        "eyebrow photo"
        "body    photo"
        ".       photo";
      min-height: clamp(34rem, 82vh, 45rem);
    }

    .hero-body {
      margin-top: 1.5rem;
    }
  }
</style>

---
import { Picture } from "astro:assets";
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import heroPhoto from "../assets/images/sobre-retrato.png";
import { hero, professional, whatsappUrl } from "../content/site";
---

<section id="hero" class="relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
  <Container class="relative">
    <div
      class="grid items-center gap-10 text-center md:gap-14 xl:grid-cols-[minmax(18rem,1fr)_auto_minmax(18rem,1fr)] xl:gap-8 xl:text-left 2xl:gap-14"
    >
      <div class="mx-auto max-w-md xl:mx-0 xl:ml-auto xl:max-w-sm xl:text-right">
        <p class="eyebrow-script">{hero.eyebrow}</p>
        <h1 class="mt-5 xl:text-[2.75rem] xl:leading-[1.12] 2xl:text-[3.25rem]">{hero.headline}</h1>
      </div>

      <div class="relative mx-auto w-full max-w-xs sm:max-w-sm xl:w-72 xl:max-w-none 2xl:w-80">
        <div
          class="pointer-events-none absolute inset-0 -z-10 scale-125 rounded-full bg-sage/20 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div class="radius-organic-lg relative aspect-[4/5] overflow-hidden">
          <Picture
            src={heroPhoto}
            alt={hero.imageAlt}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[400, 640, 900]}
            sizes="(min-width: 1280px) 18rem, 80vw"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover object-top"
          />
        </div>
      </div>

      <div class="mx-auto max-w-md xl:mx-0 xl:mr-auto xl:max-w-sm">
        <p class="measure mx-auto text-lg text-graphite xl:mx-0">{hero.sub}</p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-4 xl:justify-start">
          <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <Icon name="whatsapp" class="h-5 w-5" />
            {hero.ctaPrimary}
          </a>
          <a href="#como-funciona" class="btn btn-secondary">
            {hero.ctaSecondary}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>

        <div class="mt-10 flex flex-col items-center gap-4 xl:items-start">
          <span class="h-px w-10 bg-gold" aria-hidden="true"></span>
          <p class="caption text-balance text-graphite">
            {professional.fullName} · {professional.role} · {professional.crpLabel}
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>
